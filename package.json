{
  "name": "research-assistant",
  "version": "0.2.9",
  "private": false,
  "description": "Local-first AI-friendly research task and computation manager.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiztuoo-cyber/research-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/wiztuoo-cyber/research-assistant/issues"
  },
  "homepage": "https://github.com/wiztuoo-cyber/research-assistant#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "lint": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check.ts",
    "task": "tsx src/cli.ts",
    "ai:scan": "scripts/ai-scan-reminders.sh",
    "ai:scan:reminders": "AI_SCAN_SYNC_REMINDERS=1 scripts/ai-scan-reminders.sh",
    "ai:scan:install": "scripts/install-ai-scan-launchd.sh",
    "message:dispatch": "scripts/message-dispatch.sh",
    "message:dispatch:install": "scripts/install-message-dispatch-launchd.sh",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.1.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.21.0",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "main": "dist/server/electron/main.js",
  "build": {
    "appId": "com.local.personalassistant",
    "productName": "私人助理",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "私人助理"
    }
  }
}
